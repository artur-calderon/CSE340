<%- include('partials/header') %>

<main class="container">
    <h1><%= title %></h1>

    <section class="card">
        <h2>Your Volunteer Projects</h2>
        <% if (!volunteerProjects || volunteerProjects.length === 0) { %>
            <p>You are not signed up for any projects yet.</p>
        <% } else { %>
            <ul>
                <% volunteerProjects.forEach(function(proj) { %>
                    <li>
                        <a href="/projects/<%= proj.project_id %>"><%= proj.title %></a>
                        — <span class="muted"><%= proj.organization_name %> on <%= new Date(proj.date).toLocaleDateString('en-US',{ year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                        <form class="inline-form" method="post" action="/projects/<%= proj.project_id %>/unvolunteer" style="display:inline; margin-left:1rem;">
                            <button type="submit" class="btn danger">Cancel volunteering</button>
                        </form>
                    </li>
                <% }) %>
            </ul>
        <% } %>
    </section>

</main>

<%- include('partials/footer') %>
