<%- include('partials/header') %>

<main>
	<h1><%= title %></h1>

	<% if (!project) { %>
		<p>Project not found.</p>
	<% } else { %>
		<form action="/edit-project/<%= project.project_id %>" method="POST">
			<div class="form-group">
				<label for="title">Project Title</label>
				<input
					type="text"
					id="title"
					name="title"
					required
					maxlength="150"
					value="<%= project.title %>" />
			</div>

			<div class="form-group">
				<label for="organizationId">Organization</label>
				<select id="organizationId" name="organizationId" required>
					<% organizations.forEach((organization) => { %>
						<option
							value="<%= organization.organization_id %>"
							<%= String(organization.organization_id) === String(project.organization_id) ? 'selected' : '' %>>
							<%= organization.name %>
						</option>
					<% }) %>
				</select>
			</div>

			<div class="form-group">
				<label for="date">Date</label>
				<input
					type="date"
					id="date"
					name="date"
					required
					value="<%= project.date ? new Date(project.date).toISOString().split('T')[0] : '' %>" />
			</div>

			<div class="form-group">
				<label for="description">Description</label>
				<textarea id="description" name="description" required maxlength="1000"><%= project.description %></textarea>
			</div>

			<div class="form-group">
				<label for="location">Location</label>
				<input
					type="text"
					id="location"
					name="location"
					required
					maxlength="200"
					value="<%= project.location %>" />
			</div>

			<button type="submit">Update Project</button>
		</form>
	<% } %>
</main>

<%- include('partials/footer') %>