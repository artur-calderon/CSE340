<%- include('partials/header') %>
<main>
	<h1><%= title %></h1>

	<p>Here are a few of our partner organizations:</p>
	
	<ul>
		<% organizations.forEach(organization => { %>
		<li>
			<img src="/images/<%= organization.logo_filename %>"alt="<%= organization.name %>" />
			<strong><%= organization.name %></strong>: <%= organization.contact_email %>
			<a href="/organizations/<%= organization.organization_id %>">View details</a>
			<a href="/edit-organization/<%= organization.organization_id%>">Edit</a>
		</li>
		<% }) %>
	</ul>
	<p><a href="/new-organization">Add a new organization</a></p>
</main>
<%- include('partials/footer') %>
